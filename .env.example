# ===================================================
# Doon Anandam CRM - Environment Variables Example
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/doon_anandam_crm
# Optional: Set to true if local development experiences querySrv ECONNREFUSED on MongoDB Atlas
USE_CUSTOM_DNS=false

# Authentication (To be configured in future phase)
JWT_SECRET=your_jwt_secret_placeholder_min_32_characters
JWT_EXPIRES_IN=7d

# Client Configuration (Optional: defaults to relative '/api' for single-service deployment)
# VITE_API_BASE_URL=http://localhost:5000/api
