PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/doon_anandam_crm
JWT_SECRET=your_jwt_secret_placeholder_min_32_characters
JWT_EXPIRES_IN=7d

# Optional: Enable Google Public DNS (8.8.8.8, 8.8.4.4) for local development if experiencing querySrv ECONNREFUSED
# Never enabled in production mode
USE_CUSTOM_DNS=false

# Windsor.ai Facebook Lead Ads Connector (Backend Only)
WINDSOR_API_KEY=replace_with_your_windsor_api_key
WINDSOR_ACCOUNT_ID=replace_with_your_confirmed_account_id
WINDSOR_API_BASE_URL=https://connectors.windsor.ai
WINDSOR_DATE_PRESET=last_7d
WINDSOR_REQUEST_TIMEOUT_MS=15000

# Rate Limiting Configuration (Defaults: 15 min window, 600 max requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600


