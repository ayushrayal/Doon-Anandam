# Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.js

# Environment and secrets (exclude all .env files across all directories)
.env
.env.*
**/.env
**/.env.*

# Explicitly allow safe environment example templates
!.env.example
!.env.*.example
!**/.env.example
!**/.env.*.example

# Local credentials, certificates, keys, and database dumps
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.dump
*.sql
*.sqlite
*.rdb

# Production build and test coverage outputs
dist/
**/dist/
build/
**/build/
coverage/
**/coverage/
.nyc_output/

# Logs and debug artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
logs/
**/logs/
*.log

# Editor and OS local files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
